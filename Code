tax_rate = [
    (150000, 0.00),
    (300000, 0.05),
    (500000, 0.10),
    (750000, 0.15),
    (1000000, 0.20),
    (2000000, 0.25),
    (5000000, 0.30),
    (float('inf'), 0.35)]

def calc_tax(net_income):
    tax = 0
    previous_step = 0 #step คือลำดับขั้นภาษีก่อนหน้า
    for step, rate in tax_rate:
        if net_income <= step:
            tax += (net_income - previous_step) * rate
            break
        else:
            tax += (step - previous_step) * rate
            previous_step = step
    return tax

